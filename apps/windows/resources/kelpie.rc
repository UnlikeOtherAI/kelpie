#include <winresrc.h>
#include "resource.h"

IDI_KELPIE ICON "kelpie.ico"

1 RT_MANIFEST "manifest.xml"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,4,0
 PRODUCTVERSION 0,1,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "UnlikeOtherAI\0"
      VALUE "FileDescription", "Kelpie Windows Browser\0"
      VALUE "FileVersion", "0.1.4\0"
      VALUE "InternalName", "kelpie.dll\0"
      VALUE "OriginalFilename", "kelpie.dll\0"
      VALUE "ProductName", "Kelpie\0"
      VALUE "ProductVersion", "0.1.4\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
