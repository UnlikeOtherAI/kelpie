<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.25</string>
	<key>CFBundleVersion</key>
	<string>53</string>
	<key>CFBundleURLTypes</key>
    <array><dict><key>CFBundleURLSchemes</key><array><string>com.unlikeotherai.kelpie</string></array>
    <key>CFBundleURLName</key><string>UOA sign-in</string></dict></array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Kelpie uses Bluetooth when a website asks to connect to a nearby device, such as a phone used for sign-in.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_kelpie._tcp</string>
		<string>_kelpie-sync._tcp</string>
		<string>_appreveal._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Kelpie uses the local network to receive browser automation commands from the CLI and to sync cookies with your other signed-in Kelpie devices.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kelpie uses the microphone for websites you allow and for voice prompts in local AI.</string>
	<key>NSQuitAlwaysKeepsWindows</key>
	<false/>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
</dict>
</plist>
