<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. allowBackup="false" stops cloud backup but not device-to-device
     transfer, so cookie sync metadata is excluded from both explicitly. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="sync/" />
    </device-transfer>
</data-extraction-rules>
